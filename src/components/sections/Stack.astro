---
import SectionHeader from '../ui/SectionHeader.astro';
import { useLocale } from '../../i18n/ui';

const { t } = useLocale(Astro.currentLocale);

// DRAFT — confirm with the team. Order matters (rendered top → bottom); area names per language
// are in src/i18n/ui.ts (stack.areas), in the same order.
const tools = [
  ['TypeScript', 'Node.js', 'React', 'Astro', 'PostgreSQL'],
  ['React Native', 'Flutter', 'PWA'],
  ['Docker', 'Cloudflare', 'AWS', 'CI/CD'],
  ['C/C++', 'ESP32', 'STM32', 'MQTT'],
  ['Python', 'LLM integration', 'Computer vision'],
];
const stack = tools.map((list, i) => ({ area: t.stack.areas[i], tools: list }));
---

<section class="section" id="stack" aria-labelledby="stack-title">
  <div class="container">
    <SectionHeader
      id="stack-title"
      num="05"
      label={t.stack.label}
      title={t.stack.title}
      lead={t.stack.lead}
    />
    <div class="table-wrap" data-reveal>
      <table class="stack mono">
        <caption class="sr-only">{t.stack.caption}</caption>
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">{t.stack.area}</th>
            <th scope="col">{t.stack.tools}</th>
          </tr>
        </thead>
        <tbody>
          {stack.map((row, i) => (
            <tr>
              <td class="stack__idx">{String(i).padStart(2, '0')}</td>
              <th scope="row">{row.area}</th>
              <td>
                <ul class="stack__tools">
                  {row.tools.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--c-line);
  }
  .stack {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  .stack th,
  .stack td {
    text-align: left;
    padding: var(--s-4) var(--s-5);
    border-bottom: 1px solid var(--c-line);
    vertical-align: top;
  }
  .stack thead th {
    font-weight: 400;
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
    background: var(--c-surface);
  }
  .stack tbody tr:last-child > * {
    border-bottom: 0;
  }
  .stack tbody tr {
    transition: background var(--dur) var(--ease);
  }
  .stack tbody tr:hover {
    background: var(--c-surface);
  }
  .stack tbody th {
    font-weight: 500;
    white-space: nowrap;
  }
  .stack__idx {
    color: var(--c-muted);
    width: 3rem;
  }
  .stack__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    list-style: none;
    padding: 0;
    color: var(--c-muted);
  }
  .stack__tools li::before {
    content: '+ ';
    color: var(--c-line-strong);
  }
</style>
