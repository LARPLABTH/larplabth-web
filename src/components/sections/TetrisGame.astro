---
/** Minimal mono Tetris, shown under the pixel field in the hero. Logic: src/scripts/fx/tetris.ts */
---

<figure class="game" data-tetris data-reveal>
  <div class="game__frame">
    <div class="game__board">
      <canvas
        class="game__canvas"
        data-tetris-board
        tabindex="0"
        role="application"
        aria-label="Tetris. Press Enter to start. Arrow keys move and rotate, space drops, P pauses."
      ></canvas>
      <button class="game__overlay mono" type="button" data-tetris-overlay>
        <span class="game__screen" data-tetris-screen></span>
      </button>
    </div>

    <div class="game__side mono">
      <ul class="game__rows">
        <li class="row row--next">
          <span class="row__k">next</span>
          <span class="row__dots" aria-hidden="true"></span>
          <canvas class="game__next" data-tetris-next aria-hidden="true"></canvas>
        </li>
        <li class="row">
          <span class="row__k">score</span>
          <span class="row__dots" aria-hidden="true"></span>
          <span class="row__v" data-tetris-score>
            0
          </span>
        </li>
        <li class="row">
          <span class="row__k">lines</span>
          <span class="row__dots" aria-hidden="true"></span>
          <span class="row__v" data-tetris-lines>
            0
          </span>
        </li>
        <li class="row">
          <span class="row__k">level</span>
          <span class="row__dots" aria-hidden="true"></span>
          <span class="row__v" data-tetris-level>
            1
          </span>
        </li>
        <li class="row">
          <span class="row__k">best</span>
          <span class="row__dots" aria-hidden="true"></span>
          <span class="row__v" data-tetris-best>
            0
          </span>
        </li>
      </ul>

      <ul class="game__rows game__rows--keys">
        <li class="row">
          <span class="row__k">move</span>
          <span class="row__dots" aria-hidden="true"></span>
          <span class="row__v">← →</span>
        </li>
        <li class="row">
          <span class="row__k">rotate</span>
          <span class="row__dots" aria-hidden="true"></span>
          <span class="row__v">↑</span>
        </li>
        <li class="row">
          <span class="row__k">soft drop</span>
          <span class="row__dots" aria-hidden="true"></span>
          <span class="row__v">↓</span>
        </li>
        <li class="row">
          <span class="row__k">hard drop</span>
          <span class="row__dots" aria-hidden="true"></span>
          <span class="row__v">space</span>
        </li>
        <li class="row">
          <span class="row__k">pause</span>
          <span class="row__dots" aria-hidden="true"></span>
          <span class="row__v">p</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="game__pad mono" aria-label="Touch controls">
    <button type="button" data-action="left" aria-label="Move left">
      &lt;
    </button>
    <button type="button" data-action="rotate" aria-label="Rotate">
      rot
    </button>
    <button type="button" data-action="right" aria-label="Move right">
      &gt;
    </button>
    <button type="button" data-action="down" aria-label="Soft drop">
      v
    </button>
    <button type="button" data-action="drop" aria-label="Hard drop">
      drop
    </button>
  </div>

  <figcaption class="game__cap label">
    <span>Fig.01 — tetris</span>
    <span class="game__hint">click to play</span>
  </figcaption>
</figure>

<script>
  import { mountTetris } from '../../scripts/fx/tetris';
  document.querySelectorAll<HTMLElement>('[data-tetris]').forEach(mountTetris);
</script>

<style>
  .game {
    display: grid;
    gap: var(--s-3);
    min-width: 0;
    --cell: 15px;
  }
  .game__frame {
    display: flex;
    gap: var(--s-6);
    padding: var(--s-4);
    border: 1px solid var(--c-line);
    background: var(--c-bg);
  }
  .game__board {
    position: relative;
    flex: none;
    width: calc(var(--cell) * 10);
    aspect-ratio: 1 / 2;
  }
  .game__canvas {
    display: block;
    width: 100%;
    height: 100%;
    outline: none;
    touch-action: none;
  }
  .game__board:has(.game__canvas:focus-visible) {
    outline: 1px solid var(--c-signal);
    outline-offset: 4px;
  }

  /* start / pause / game-over screen: drawn like a terminal session */
  .game__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    padding: var(--s-3);
    background: color-mix(in srgb, var(--c-bg) 92%, transparent);
    border: 0;
    color: var(--c-text);
    text-align: left;
    cursor: pointer;
  }
  .game__screen {
    display: grid;
    gap: 2px;
    font-size: var(--fs-xs);
    line-height: 1.7;
  }
  .game__screen :global(.game__line) {
    white-space: pre;
  }
  .game__screen :global(.game__line--out),
  .game__screen :global(.game__line--hint) {
    color: var(--c-muted);
  }
  .game__screen :global(.game__line--hint) {
    margin-top: var(--s-3);
    padding-top: var(--s-2);
    border-top: 1px dotted var(--c-line-strong);
  }
  .game__overlay:hover :global(.game__line--hint) {
    color: var(--c-text);
  }
  .game__overlay:focus-visible {
    outline: 1px solid var(--c-signal);
    outline-offset: -4px;
  }
  .game__screen :global(.touch-only) {
    display: none;
  }

  /* side panel: full-width rows with dotted leaders, like the hero terminal */
  .game__side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-4);
    min-width: 0;
    flex: 1;
    font-size: var(--fs-sm);
  }
  .game__rows {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .game__rows--keys {
    gap: 3px;
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 0.6ch;
    min-width: 0;
  }
  .row__k {
    flex: none;
    color: var(--c-muted);
    text-transform: lowercase;
  }
  .row__dots {
    flex: 1;
    min-width: 1ch;
    border-bottom: 1px dotted var(--c-line-strong);
    transform: translateY(-0.28em);
  }
  .row__v {
    flex: none;
    color: var(--c-text);
    font-variant-numeric: tabular-nums;
  }
  .row--next {
    align-items: center;
  }
  .row--next .row__dots {
    transform: none;
  }
  .row:not(.row--next) .row__v[data-tetris-score] {
    font-size: var(--fs-lg);
    line-height: 1;
  }
  .game__next {
    flex: none;
    width: 3rem;
    height: 3rem;
  }

  .game__cap {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
  }

  /* touch pad: only on touch screens */
  .game__pad {
    display: none;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--s-2);
  }
  .game__pad button {
    padding: 0.8rem 0;
    background: none;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius);
    color: var(--c-text);
    font-size: var(--fs-sm);
    touch-action: manipulation;
    user-select: none;
  }
  .game__pad button:active {
    background: var(--c-surface);
  }
  @media (pointer: coarse) {
    .game__pad {
      display: grid;
    }
    .game__rows--keys {
      display: none;
    }
    /* no key list on touch screens: spread the stats over the full board height */
    .game__rows:first-child {
      flex: 1;
      align-content: space-between;
    }
    .game__screen :global(.kb-only) {
      display: none;
    }
    .game__screen :global(.touch-only) {
      display: inline;
    }
    .game__hint {
      font-size: 0;
    }
    .game__hint::after {
      content: 'tap to play';
      font-size: var(--fs-xs);
    }
  }
  @media (max-width: 30rem) {
    .game {
      --cell: 13px;
    }
    .game__frame {
      gap: var(--s-4);
    }
  }
</style>
