---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SectionHeader from '../ui/SectionHeader.astro';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

/** Deterministic, mirrored 10×10 pixel "identicon" from a string — placeholder art. */
function identicon(input: string, size = 10): { x: number; y: number }[] {
  let h = 2166136261;
  for (const ch of input) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
  const rand = () => {
    h ^= h << 13;
    h ^= h >>> 17;
    h ^= h << 5;
    return (h >>> 0) / 4294967296;
  };
  const half = Math.ceil(size / 2);
  const cells: { x: number; y: number }[] = [];
  for (let y = 0; y < size; y++) {
    for (let x = 0; x < half; x++) {
      if (rand() > 0.55) {
        cells.push({ x, y });
        if (x !== size - 1 - x) cells.push({ x: size - 1 - x, y });
      }
    }
  }
  return cells;
}

const statusLabel = {
  'coming-soon': 'Coming soon',
  'in-progress': 'In development',
  shipped: 'Shipped',
};
---

<section class="section" id="lab" aria-labelledby="lab-title">
  <div class="container">
    <SectionHeader
      id="lab-title"
      num="04"
      label="Lab"
      title="Things we're building."
      lead="Products and experiments from the lab. The first one is already out in the open, and more are on the way."
    />
    <ul class="lab">
      {projects.map((p) => {
        const tile = (
          <>
            <div class="lab__art">
              {p.data.cover ? (
                <Image
                  src={p.data.cover}
                  alt={p.data.coverAlt}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 56rem) 760px, 100vw"
                  loading="lazy"
                />
              ) : (
                <svg viewBox="0 0 10 10" shape-rendering="crispEdges" aria-hidden="true">
                  {identicon(p.id).map((c) => (
                    <rect x={c.x} y={c.y} width="1" height="1" fill="currentColor" />
                  ))}
                </svg>
              )}
            </div>
            <div class="lab__meta">
              <p class="label">
                <span>{p.data.category}</span>
                <span class="lab__status" data-status={p.data.status}>
                  {statusLabel[p.data.status]}
                </span>
              </p>
              <h3 class="lab__title">
                {p.data.title}
                {p.data.href && (
                  <span class="lab__go mono" aria-hidden="true">
                    -&gt;
                  </span>
                )}
              </h3>
              <p class="muted">{p.data.summary}</p>
              {p.data.href && <p class="lab__url mono">{new URL(p.data.href).host}</p>}
            </div>
          </>
        );
        return (
          <li class:list={['lab__item', p.data.featured && 'lab__item--featured']} data-reveal>
            {p.data.href ? (
              <a
                class="lab__tile"
                href={p.data.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${p.data.title} (opens in a new tab)`}
              >
                {tile}
              </a>
            ) : (
              <div class="lab__tile">{tile}</div>
            )}
          </li>
        );
      })}
      <li class="lab__item lab__next" data-reveal aria-label="Next project: coming soon">
        <div class="lab__nextbox mono" aria-hidden="true">
          <p>
            <span class="muted">$</span> larp new project
          </p>
          <p class="muted">&gt; scaffolding next idea ...</p>
          <p>
            <span class="muted">$</span> <span class="cursor" />
          </p>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .lab {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
    list-style: none;
    padding: 0;
  }
  .lab__item--featured {
    grid-column: span 2;
  }
  .lab__tile {
    display: grid;
    gap: var(--s-4);
    height: 100%;
    align-content: start;
  }
  .lab__art {
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--c-line);
    background: var(--c-surface);
    color: var(--c-line-strong);
    transition:
      color 400ms var(--ease),
      border-color var(--dur) var(--ease);
  }
  .lab__item--featured .lab__art {
    aspect-ratio: 2 / 1;
  }
  .lab__art svg {
    width: 38%;
  }
  .lab__art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 600ms var(--ease);
  }
  .lab__tile:hover .lab__art {
    color: var(--c-text);
    border-color: var(--c-text);
  }
  .lab__tile:hover .lab__art :global(img) {
    transform: scale(1.02);
  }
  .lab__meta {
    display: grid;
    gap: var(--s-2);
  }
  .lab__meta .label {
    display: flex;
    justify-content: space-between;
  }
  .lab__status::before {
    content: '● ';
  }
  .lab__status[data-status='in-progress']::before {
    color: var(--c-signal);
    animation: blink 1.6s steps(1) infinite;
  }
  .lab__title {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-size: var(--fs-lg);
    font-weight: 500;
  }
  .lab__go {
    color: var(--c-muted);
    font-size: var(--fs-sm);
    transition:
      transform var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .lab__tile:hover .lab__go {
    color: var(--c-text);
    transform: translateX(4px);
  }
  .lab__meta p:not(.label):not(.lab__url) {
    font-size: var(--fs-sm);
    max-width: 44rem;
  }
  .lab__url {
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--c-muted);
  }

  /* "next project" placeholder tile — stretches to the height of its row */
  .lab__next {
    display: grid;
  }
  .lab__nextbox {
    display: grid;
    align-content: center;
    gap: var(--s-1);
    min-height: 9rem;
    padding: var(--s-5);
    border: 1px dashed var(--c-line-strong);
    font-size: var(--fs-sm);
    line-height: 1.8;
    overflow: hidden;
  }
  .lab__nextbox p {
    white-space: pre;
  }

  @media (max-width: 56rem) {
    .lab {
      grid-template-columns: minmax(0, 1fr);
    }
    .lab__item--featured {
      grid-column: auto;
    }
  }
</style>
