---
import SectionHeader from '../ui/SectionHeader.astro';

// Honest facts only — the team is anonymous for now.
const facts = [
  { label: 'Who', value: 'Students' },
  { label: 'Where', value: 'Thailand' },
  { label: 'Names', value: 'Anon' },
  { label: 'Proof', value: 'Work' },
];
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container">
    <SectionHeader
      id="about-title"
      num="01"
      label="About"
      title="Yes, we're LARPing. Watch what we ship."
    />
    <div class="about">
      <div class="about__copy" data-reveal>
        <p>
          We're <strong>LARPers</strong> — college students from Thailand who use{' '}
          <strong>LARP-Power</strong> to build projects that make a real dent in the world.
        </p>
        <p class="muted">
          The name is a joke with a point. It's sarcasm aimed at anyone who has ever said{' '}
          <em>"you guys are just LARPing, you can't actually do anything."</em> Every project we put
          out is built with real skill and real effort. So we took the insult, put it on the door,
          and decided to answer it with work.
        </p>
        <p class="muted">
          We're staying anonymous for now. The work speaks first, and the names can come later.
        </p>
      </div>

      <div class="about__side" data-reveal>
        <div
          class="term mono"
          role="img"
          aria-label="Terminal: a visitor says you are just LARPing; the reply is larp --prove, shipping."
        >
          <p>
            <span class="muted">&gt;</span> "you guys are just larping"
          </p>
          <p>
            <span class="muted">$</span> larp --prove
          </p>
          <p class="muted">&gt; building ........ ok</p>
          <p class="muted">&gt; shipping ....... ok</p>
          <p class="muted">&gt; credibility ..... earned</p>
        </div>
        <dl class="facts">
          {facts.map((f) => (
            <div class="fact">
              <dt class="label">{f.label}</dt>
              <dd class="pixel">{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--s-7);
    align-items: start;
  }
  .about__copy {
    display: grid;
    gap: var(--s-4);
    font-size: var(--fs-md);
    max-width: 38rem;
  }
  .about__copy strong {
    font-weight: 500;
    color: var(--c-text);
  }
  .about__copy em {
    font-style: normal;
    color: var(--c-text);
    background: var(--c-surface);
    padding: 0 0.3em;
  }
  .about__side {
    display: grid;
    gap: var(--s-5);
    min-width: 0;
  }
  .term {
    padding: var(--s-5) var(--s-6);
    border: 1px solid var(--c-line-strong);
    background: var(--c-surface);
    font-size: var(--fs-sm);
    line-height: 1.9;
    overflow-x: auto;
  }
  .term p {
    white-space: pre;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
  }
  .fact {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--s-2);
    padding: var(--s-5);
    background: var(--c-bg);
  }
  .fact dd {
    font-size: var(--fs-lg);
    line-height: 1;
  }
  @media (max-width: 56rem) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
