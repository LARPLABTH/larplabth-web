---
import SectionHeader from '../ui/SectionHeader.astro';

// Facts shown beside the copy. `href` makes a fact clickable.
// TODO: "HANA" is a placeholder — the team will explain what it is later.
const facts = [
  { label: 'Who', value: 'LARPERs' },
  { label: 'Where', value: 'Thailand' },
  { label: 'Infrastructure', value: 'HANA' },
  { label: 'Proof', value: 'Works', href: '#lab' },
];
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container">
    <SectionHeader
      id="about-title"
      num="01"
      label="About"
      title="College students building real software, tools & devices."
    />
    <div class="about">
      <div class="about__copy" data-reveal>
        <p>
          We're <strong>LARPers</strong> — a team of college students from Thailand. We turn our own
          ideas into projects: SaaS products, tools, services, devices and maker builds.
        </p>
        <p class="muted">
          We also work with others. If you have something to build or a problem to solve, contact us
          for development or consulting.
        </p>
        <p class="muted">We're staying anonymous for now. More about the team soon.</p>
      </div>

      <ul class="facts" data-reveal>
        {facts.map((f) => {
          const inner = (
            <>
              <span class="label">{f.label}</span>
              <span class="fact__v pixel">{f.value}</span>
              {f.href && (
                <span class="fact__go mono" aria-hidden="true">
                  -&gt;
                </span>
              )}
            </>
          );
          return (
            <li>
              {f.href ? (
                <a class="fact fact--link" href={f.href}>
                  {inner}
                </a>
              ) : (
                <div class="fact">{inner}</div>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--s-7);
    align-items: start;
  }
  .about__copy {
    display: grid;
    gap: var(--s-4);
    font-size: var(--fs-md);
    max-width: 38rem;
  }
  .about__copy strong {
    font-weight: 500;
    color: var(--c-text);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    list-style: none;
    padding: 0;
    background: var(--c-line);
    border: 1px solid var(--c-line);
  }
  .facts li {
    display: grid;
  }
  .fact {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--s-2);
    min-height: 7rem;
    padding: var(--s-5);
    background: var(--c-bg);
    overflow-wrap: anywhere;
  }
  .fact__v {
    font-size: var(--fs-lg);
    line-height: 1.1;
  }
  .fact--link {
    transition: background var(--dur) var(--ease);
  }
  .fact--link:hover {
    background: var(--c-surface);
  }
  .fact__go {
    position: absolute;
    top: var(--s-4);
    right: var(--s-4);
    color: var(--c-muted);
    transition:
      transform var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .fact--link:hover .fact__go {
    color: var(--c-text);
    transform: translateX(3px);
  }
  @media (max-width: 56rem) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
