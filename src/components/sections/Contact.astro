---
import SectionHeader from '../ui/SectionHeader.astro';
import EmailReveal from '../ui/EmailReveal.astro';
import { site } from '../../config/site';

/**
 * The form posts to the Worker in worker/contact.ts. It stays hidden (the decorative terminal
 * shows instead) until `site.contactForm.enabled` is true.
 */
const FORM_ENABLED = site.contactForm.enabled;
const siteKey = site.contactForm.turnstileSiteKey;

const topics = [
  { value: 'build', label: 'build something' },
  { value: 'consulting', label: 'consulting' },
  { value: 'join', label: 'join the team' },
  { value: 'hello', label: 'just say hi' },
];
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <SectionHeader
      id="contact-title"
      num="07"
      label="Contact"
      title="Got a problem worth solving?"
      lead="Tell us what you're building or what's broken. We reply within 12 hours — if you haven't heard back, send it again."
    />

    <div class="contact__grid">
      <div class="contact__direct" data-reveal>
        <p class="label">Find us</p>
        <ul class="rows">
          {site.socials.map((s) => (
            <li>
              <a class="rows__item" href={s.href} target="_blank" rel="noopener noreferrer">
                <span class="rows__k mono">{s.label.toLowerCase()}</span>
                <span class="rows__dots" aria-hidden="true" />
                <span class="rows__v mono">
                  {s.handle} <span aria-hidden="true">↗</span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <p class="label contact__sub">Prefer email?</p>
        <EmailReveal />
        <p class="contact__note muted">
          The form is the fastest way to reach us. We reply within 12 hours.
        </p>
      </div>

      {FORM_ENABLED ? (
        <form class="form" data-contact-form novalidate data-reveal>
          <p class="form__title mono">
            <span class="muted">$</span> larp contact --new
          </p>

          <div class="form__pair">
            <label class="field">
              <span class="field__label mono">name *</span>
              <input name="name" type="text" autocomplete="name" required maxlength="100" />
            </label>
            <label class="field">
              <span class="field__label mono">email *</span>
              <input name="email" type="email" autocomplete="email" required maxlength="200" />
            </label>
          </div>
          <label class="field">
            <span class="field__label mono">
              company <em>(optional)</em>
            </span>
            <input name="company" type="text" autocomplete="organization" maxlength="120" />
          </label>

          <fieldset class="chips">
            <legend class="field__label mono">--topic</legend>
            <div class="chips__row">
              {topics.map((t, i) => (
                <label class="chip mono">
                  <input type="radio" name="topic" value={t.value} checked={i === 0} />
                  <span>{t.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <label class="field">
            <span class="field__label mono">what are we solving? *</span>
            <textarea name="message" rows="5" required minlength="10" maxlength="5000" />
          </label>

          {/* Honeypot: hidden from people, irresistible to bots. */}
          <div class="form__trap" aria-hidden="true">
            <label>
              Website <input name="website" type="text" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <div class="checks">
            <label class="check">
              <input type="checkbox" name="terms" required />
              <span class="check__box" aria-hidden="true" />
              <span>
                I agree to the{' '}
                <a href="/terms" target="_blank" rel="noopener">
                  Terms
                </a>{' '}
                and{' '}
                <a href="/privacy" target="_blank" rel="noopener">
                  Privacy Policy
                </a>
                . *
              </span>
            </label>
            <label class="check">
              <input type="checkbox" name="marketing" />
              <span class="check__box" aria-hidden="true" />
              <span>
                Email me occasional updates from {site.name}{' '}
                <em>(optional — unsubscribe any time)</em>.
              </span>
            </label>
          </div>

          {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="auto" />}

          <div class="form__foot">
            <button class="btn-send mono" type="submit">
              <span data-send-label>send message</span>
              <span aria-hidden="true">-&gt;</span>
            </button>
            <p class="form__status mono" role="status" aria-live="polite" data-form-status />
          </div>
        </form>
      ) : (
        <div class="contact__term mono" data-reveal aria-hidden="true">
          <p>
            <span class="muted">$</span> larp contact --new
          </p>
          <p class="muted">&gt; name ......... your name</p>
          <p class="muted">&gt; company ...... optional</p>
          <p class="muted">&gt; problem ...... what needs solving?</p>
          <p class="muted">&gt; budget ....... rough range helps</p>
          <p>
            <span class="muted">$</span> <span class="cursor" />
          </p>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const label = form.querySelector<HTMLElement>('[data-send-label]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const MESSAGES: Record<string, string> = {
      name_required: 'Please enter your name.',
      email_invalid: 'That email address looks off.',
      message_too_short: 'Tell us a bit more (at least 10 characters).',
      terms_required: 'Please accept the Terms and Privacy Policy to send your message.',
      captcha_required: 'Please complete the check below.',
      captcha_failed: 'The check failed — please try again.',
      not_configured: 'The form is not ready yet — please email us directly.',
    };
    const say = (text: string, kind: 'ok' | 'err' | '' = '') => {
      status.textContent = text;
      status.dataset.kind = kind;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const fd = new FormData(form);
      const payload: Record<string, unknown> = Object.fromEntries(fd.entries());
      payload.terms = fd.get('terms') === 'on';
      payload.marketing = fd.get('marketing') === 'on';
      payload.turnstileToken = String(fd.get('cf-turnstile-response') ?? '');

      submit.disabled = true;
      label.textContent = 'sending…';
      say('');
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (res.ok && body.ok) {
          form.reset();
          say('Sent. We reply within 12 hours.', 'ok');
          label.textContent = 'sent ✓';
          setTimeout(() => (label.textContent = 'send message'), 4000);
          (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
        } else {
          say(
            MESSAGES[body.error ?? ''] ?? 'Something went wrong — please email us directly.',
            'err',
          );
          label.textContent = 'send message';
        }
      } catch {
        say('Network error — please try again or email us directly.', 'err');
        label.textContent = 'send message';
      } finally {
        submit.disabled = false;
      }
    });

    // Load Cloudflare Turnstile only when the form is about to be used, so visitors who
    // never reach Contact don't download it.
    if (form.querySelector('.cf-turnstile')) {
      let loaded = false;
      const loadTurnstile = () => {
        if (loaded) return;
        loaded = true;
        io.disconnect();
        const t = document.createElement('script');
        t.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
        t.async = true;
        t.defer = true;
        document.head.appendChild(t);
      };
      const io = new IntersectionObserver(
        (entries) => entries.some((e) => e.isIntersecting) && loadTurnstile(),
        { rootMargin: '600px 0px' },
      );
      io.observe(form);
      form.addEventListener('focusin', loadTurnstile, { once: true });
    }
  }
</script>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--s-7);
    align-items: start;
  }
  .contact__direct {
    display: grid;
    gap: var(--s-4);
    min-width: 0;
  }
  .contact__sub {
    margin-top: var(--s-4);
  }
  .contact__note {
    font-size: var(--fs-sm);
    max-width: 24rem;
  }

  /* social links: label ......... handle ↗ (same dotted rows as the Tetris panel) */
  .rows {
    display: grid;
    gap: var(--s-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows__item {
    display: flex;
    align-items: baseline;
    gap: 0.6ch;
    padding: var(--s-2) 0;
    font-size: var(--fs-sm);
  }
  .rows__k {
    flex: none;
    color: var(--c-muted);
  }
  .rows__dots {
    flex: 1;
    min-width: 1ch;
    border-bottom: 1px dotted var(--c-line-strong);
    transform: translateY(-0.28em);
  }
  .rows__v {
    flex: none;
    color: var(--c-text);
    text-align: right;
  }
  .rows__item:hover .rows__v {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .rows__item:hover .rows__k {
    color: var(--c-text);
  }

  .contact__term {
    padding: var(--s-5) var(--s-6);
    border: 1px solid var(--c-line-strong);
    background: var(--c-surface);
    font-size: var(--fs-sm);
    line-height: 1.9;
    overflow-x: auto;
  }
  .contact__term p {
    white-space: pre;
  }

  /* ---- form ---- */
  .form {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-6);
    border: 1px solid var(--c-line-strong);
    background: var(--c-surface);
    min-width: 0;
  }
  .form__title {
    font-size: var(--fs-sm);
  }
  .form__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .field {
    display: grid;
    gap: var(--s-2);
    min-width: 0;
  }
  .field__label {
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .field__label em {
    font-style: normal;
    text-transform: none;
    letter-spacing: 0;
    opacity: 0.8;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0.7rem 0.8rem;
    background: var(--c-bg);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius);
    font-size: var(--fs-base);
    transition: border-color var(--dur) var(--ease);
  }
  .field textarea {
    resize: vertical;
    min-height: 7rem;
  }
  .field input:hover,
  .field textarea:hover {
    border-color: var(--c-muted);
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--c-signal);
  }

  /* topic chips (radio group) */
  .chips {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .chips__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .chip {
    position: relative;
    cursor: pointer;
  }
  .chip input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-block;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--c-muted);
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .chip:hover span {
    border-color: var(--c-text);
    color: var(--c-text);
  }
  .chip input:checked + span {
    background: var(--c-text);
    border-color: var(--c-text);
    color: var(--c-bg);
  }
  .chip input:focus-visible + span {
    outline: 1px solid var(--c-signal);
    outline-offset: 3px;
  }

  /* consent checkboxes */
  .checks {
    display: grid;
    gap: var(--s-3);
  }
  .check {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-3);
    align-items: start;
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--c-muted);
    cursor: pointer;
  }
  .check input {
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    opacity: 0;
    cursor: pointer;
  }
  .check__box {
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.15rem;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius);
    background: var(--c-bg);
    transition:
      background var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .check input:checked + .check__box {
    background: var(--c-text);
    border-color: var(--c-text);
  }
  .check input:checked + .check__box::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    background: var(--c-bg);
  }
  .check input:focus-visible + .check__box {
    outline: 1px solid var(--c-signal);
    outline-offset: 3px;
  }
  .check a {
    color: var(--c-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .check em {
    font-style: normal;
    opacity: 0.8;
  }

  .form__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
  }
  .btn-send {
    display: inline-flex;
    gap: 0.75rem;
    padding: 0.8rem 1.1rem;
    background: var(--c-text);
    color: var(--c-bg);
    border: 1px solid var(--c-text);
    border-radius: var(--radius);
    font-size: var(--fs-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .btn-send:hover:not(:disabled) {
    background: transparent;
    color: var(--c-text);
  }
  .btn-send:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .form__status {
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }
  .form__status[data-kind='ok'] {
    color: var(--c-text);
  }
  .form__status[data-kind='err'] {
    color: var(--th-red);
  }
  @media (max-width: 56rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .form {
      padding: var(--s-5) var(--s-4);
    }
    .form__pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
