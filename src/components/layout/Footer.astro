---
import Logo from '../brand/Logo.astro';
import PixelIcon from '../ui/PixelIcon.astro';
import { nav, site } from '../../config/site';
import { useLocale } from '../../i18n/ui';
import { kw } from '../../i18n/thai';

const { t, path } = useLocale(Astro.currentLocale);

// Easter egg: the team name in 8-bit binary.
const binary = [...'LARP LAB TH']
  .map((c) => c.charCodeAt(0).toString(2).padStart(8, '0'))
  .join(' ');
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="ftr__bits mono" aria-hidden="true" data-bits={`${binary} ${binary} ${binary}`}></div>
  <div class="container ftr__inner">
    <div class="ftr__brand">
      <Logo uid="f" height={18} />
      <p class="ftr__tag" set:html={kw(t.meta.tagline)} />
      <ul class="ftr__social" aria-label={t.footer.social}>
        {site.socials.map((x) => (
          <li>
            <a
              class="ftr__icon"
              href={x.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${x.label}: ${x.handle}`}
              title={x.label}
            >
              <PixelIcon name={x.icon} size={22} />
            </a>
          </li>
        ))}
      </ul>
    </div>
    <nav aria-label={t.footer.nav}>
      <ul class="ftr__nav">
        {nav.map((id) => (
          <li>
            <a href={path(`/#${id}`)}>{t.nav[id]}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="ftr__meta label">
      <span>
        © {year} {site.name}
      </span>
      <span>{t.footer.location}</span>
      <a href={path('/terms/')}>{t.footer.terms}</a>
      <a href={path('/privacy/')}>{t.footer.privacy}</a>
      <button type="button" class="ftr__link" data-open-consent>
        {t.footer.storage}
      </button>
    </div>
  </div>
</footer>

<style>
  .ftr {
    border-top: 1px solid var(--c-line);
    padding-bottom: calc(var(--s-6) + env(safe-area-inset-bottom, 0px));
  }
  .ftr__bits::before {
    content: attr(data-bits);
  }
  .ftr__bits {
    overflow: hidden;
    white-space: nowrap;
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--c-line);
    font-size: var(--fs-xs);
    color: var(--c-line-strong);
    letter-spacing: 0.1em;
  }
  .ftr__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--s-7) var(--s-6);
    padding-top: var(--s-8);
  }
  .ftr__brand {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .ftr__nav {
    list-style: none;
    padding: 0;
    columns: 2;
    font-size: var(--fs-sm);
  }
  .ftr__nav li {
    padding-block: 0.2rem;
  }
  .ftr__nav a {
    color: var(--c-text);
    opacity: 0.8;
  }
  .ftr__nav a:hover {
    opacity: 1;
  }
  .ftr__nav a:hover,
  .ftr__meta a:hover {
    color: var(--c-text);
  }
  .ftr__tag {
    color: var(--c-text);
    opacity: 0.85;
  }
  .ftr__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
  }
  .ftr__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--c-line-strong);
    color: var(--c-text);
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .ftr__icon:hover,
  .ftr__icon:focus-visible {
    background: var(--c-text);
    border-color: var(--c-text);
    color: var(--c-bg);
  }
  .ftr__link {
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
    cursor: pointer;
  }
  .ftr__link:hover {
    color: var(--c-text);
  }
  .ftr__meta {
    color: var(--c-text);
    opacity: 0.75;
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-line);
  }
  @media (max-width: 40rem) {
    .ftr__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
