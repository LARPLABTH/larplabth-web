---
/** Toggles data-theme on <html>; persists the choice. Initial theme is set inline in BaseLayout. */
---

<button class="theme-toggle" type="button" data-theme-toggle>
  <span class="sr-only">Colour theme:</span>
  <svg viewBox="0 0 8 8" width="16" height="16" shape-rendering="crispEdges" aria-hidden="true">
    <rect
      x="0.5"
      y="0.5"
      width="7"
      height="7"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
    ></rect>
    <rect class="theme-toggle__fill" x="1" y="1" width="3" height="6" fill="currentColor"></rect>
  </svg>
  <span class="theme-toggle__label label" data-theme-label>
    dark
  </span>
</button>

<script>
  import { CONSENT_EVENT, prefGet, prefSet } from '../../scripts/consent';

  const root = document.documentElement;
  let chosen = false; // the visitor toggled the theme during this visit

  function sync() {
    const theme = root.dataset.theme === 'light' ? 'light' : 'dark';
    document.querySelectorAll<HTMLElement>('[data-theme-label]').forEach((el) => {
      el.textContent = theme;
    });
    const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    if (meta) meta.content = theme === 'light' ? '#f2f1ec' : '#0f0f0f';
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
      chosen = true;
      prefSet('theme', root.dataset.theme); // saved only if the visitor accepted storage
      sync();
    });
  });

  // If they accept storage after already picking a theme, remember that pick.
  document.addEventListener(CONSENT_EVENT, () => {
    if (chosen) prefSet('theme', root.dataset.theme ?? 'dark');
  });

  // Follow the OS while the visitor hasn't chosen explicitly.
  window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
    if (chosen || prefGet('theme')) return;
    root.dataset.theme = e.matches ? 'light' : 'dark';
    sync();
  });

  sync();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.5rem;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--c-text);
    cursor: pointer;
  }
  .theme-toggle:hover {
    border-color: var(--c-line-strong);
  }
  .theme-toggle__fill {
    transition: transform var(--dur) var(--ease);
  }
  :global(:root[data-theme='light']) .theme-toggle__fill {
    transform: translateX(3px);
  }
  .theme-toggle__label {
    min-width: 5ch;
    text-align: left;
  }
</style>
