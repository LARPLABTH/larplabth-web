---
/**
 * LARP LAB TH logo — two forms, both drawn from src/config/brand.ts:
 *   full: `<L/>ARP LAB TH` — the first letter is the `<L/>` mark. Hover (or keyboard focus on
 *         the parent link) on TH → it expands to TECH: T red, E white, C blue, H red.
 *         With `intro`, the logo first appears as `<L/>` alone, then ARP LAB TH draws out.
 *   mark: `<L/>` on its own.
 *
 * `uid` keeps SVG ids unique when the logo appears more than once on a page.
 */
import { ADV, GLYPH, LAYOUT, MARK, MARK_X, CAP } from '../../config/brand';

interface Props {
  variant?: 'full' | 'mark';
  uid?: string;
  /** rendered height of the capital letters, in px */
  height?: number;
  /** play the `<L/>` → full wordmark intro on page load */
  intro?: boolean;
  class?: string;
}
const { variant = 'full', uid = 'x', height = 14, intro = false, class: className } = Astro.props;

const letters = (word: string, x0: number) =>
  [...word].map((c, i) => ({ d: GLYPH[c]!, x: x0 + i * ADV }));
// everything after the `<L/>`, in reveal order
const rest = [...letters('ARP', LAYOUT.arp), ...letters('LAB', LAYOUT.lab)];
const th = LAYOUT.th;
const W = LAYOUT.widthTECH;
---

{variant === 'full' ? (
  <span
    class:list={['logo', 'logo--full', intro && 'logo--intro', className]}
    style={`--logo-h:${height}px`}
  >
    <svg class="logo__svg" viewBox={`-1 0 ${W + 2} ${CAP}`} role="img" aria-label="LARP LAB TH">
      <defs>
        <clipPath id={`clip-${uid}`}>
          <rect x="-1" y="-1" width={W + 2} height={CAP + 2} />
        </clipPath>
      </defs>
      <g class="logo__paths" clip-path={`url(#clip-${uid})`}>
        <g class="logo__lmark" transform={`translate(${MARK_X} 0)`}>
          <path class="logo__dim" d={MARK.lt} />
          <path d={MARK.l} transform={`translate(${MARK.lx} 0)`} />
          <path class="logo__dim" d={MARK.slash} />
          <path class="logo__dim" d={MARK.gt} />
        </g>
        <g class="logo__rest">
          {rest.map((l, i) => (
            <g class="logo__letter" style={`--i:${i}`}>
              <path d={l.d} transform={`translate(${l.x} 0)`} />
            </g>
          ))}
          <g class="logo__th" style="--i:6">
            <rect class="logo__hit" x={th - 3} y="-1" width={W - th + 4} height={CAP + 2} />
            <path class="logo__t" d={GLYPH.T} transform={`translate(${th} 0)`} />
            <g class="logo__ec" aria-hidden="true">
              <path
                class="logo__e"
                pathLength="1"
                d={GLYPH.E}
                transform={`translate(${th + ADV} 0)`}
              />
              <path
                class="logo__c"
                pathLength="1"
                d={GLYPH.C}
                transform={`translate(${th + 2 * ADV} 0)`}
              />
            </g>
            <g transform={`translate(${th + ADV} 0)`}>
              <path class="logo__h" d={GLYPH.H} />
            </g>
          </g>
        </g>
      </g>
    </svg>
  </span>
) : (
  <span class:list={['logo', 'logo--mark', className]} style={`--logo-h:${height}px`}>
    <svg class="logo__svg" viewBox={MARK.viewBox} role="img" aria-label="LARP LAB TH">
      <defs>
        <clipPath id={`mclip-${uid}`}>
          <rect x="-2" y="0" width="34" height={CAP} />
        </clipPath>
      </defs>
      <g class="logo__paths" clip-path={`url(#mclip-${uid})`}>
        <path class="logo__dim" d={MARK.lt} />
        <path d={MARK.l} transform={`translate(${MARK.lx} 0)`} />
        <path class="logo__dim" d={MARK.slash} />
        <path class="logo__dim" d={MARK.gt} />
      </g>
    </svg>
  </span>
)}

<style>
  .logo {
    display: inline-flex;
    color: var(--c-text);
    line-height: 0;
  }
  .logo__svg {
    display: block;
    height: var(--logo-h, 14px);
    width: auto;
    overflow: visible;
  }
  .logo__paths :global(path) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: miter;
    stroke-linecap: butt;
  }
  .logo__paths :global(.logo__dim) {
    stroke: var(--c-muted);
  }
  .logo__hit {
    fill: transparent;
  }

  /* ---- TH → TECH ---- */
  .logo__th path {
    stroke: var(--c-muted);
    transition: stroke 200ms var(--ease);
  }
  .logo__th .logo__e {
    stroke: var(--th-white);
  }
  .logo__th .logo__c {
    stroke: var(--th-blue);
  }
  .logo__h {
    transition:
      transform 320ms var(--ease),
      stroke 200ms var(--ease);
  }
  .logo__ec path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    transition:
      stroke-dashoffset 300ms var(--ease),
      opacity 120ms linear;
  }
  .logo__c {
    transition-delay: 90ms;
  }

  .logo__th:hover .logo__t,
  .logo__th:hover .logo__h,
  :global(a:focus-visible) .logo__th .logo__t,
  :global(a:focus-visible) .logo__th .logo__h {
    stroke: var(--th-red);
  }
  .logo__th:hover .logo__h,
  :global(a:focus-visible) .logo__th .logo__h {
    transform: translateX(20px);
  }
  .logo__th:hover .logo__ec path,
  :global(a:focus-visible) .logo__th .logo__ec path {
    stroke-dashoffset: 0;
    opacity: 1;
  }

  /* ---- intro: <L/> first, then ARP LAB TH draws out ---- */
  .logo--intro .logo__letter,
  .logo--intro .logo__th {
    animation: logo-in 420ms var(--ease) both;
    animation-delay: calc(500ms + var(--i, 0) * 45ms);
  }
  @keyframes logo-in {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo--intro .logo__letter,
    .logo--intro .logo__th {
      animation: none;
    }
  }
</style>
