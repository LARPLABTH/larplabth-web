---
import { kw } from '../../i18n/thai';

interface Props {
  num: string; // "01"
  label: string; // "What we do"
  title: string;
  lead?: string;
  /** id for the <h2>, so the parent <section> can use aria-labelledby */
  id?: string;
}
const { num, label, title, lead, id } = Astro.props;
// kw(): keeps Thai compound words from breaking mid-word (src/i18n/thai.ts)
---

<header class="sh" data-reveal>
  <p class="sh__tag">
    <span class="sh__bubble mono" data-scramble>
      {num}
    </span>
    <span class="sh__topic mono">{label}</span>
    <span class="sh__rule" aria-hidden="true"></span>
  </p>
  <h2 class="sh__title" id={id} set:html={kw(title)} />
  {lead && <p class="sh__lead" set:html={kw(lead)} />}
</header>

<style>
  .sh {
    display: grid;
    gap: var(--s-4);
    margin-bottom: var(--s-8);
    max-width: 52rem;
  }
  .sh__tag {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  /* numbered bubble: the section's place in the page sequence */
  .sh__bubble {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--c-text);
    border-radius: 50%;
    font-size: var(--fs-sm);
    letter-spacing: 0.02em;
    color: var(--c-bg);
    background: var(--c-text);
  }
  .sh__topic {
    font-size: var(--fs-md);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text);
  }
  .sh__rule {
    flex: 1;
    height: 1px;
    min-width: 2rem;
    max-width: 10rem;
    background: var(--c-line-strong);
  }
  .sh__title {
    font-size: var(--fs-xl);
  }
  .sh__lead {
    color: var(--c-muted);
    font-size: var(--fs-md);
    max-width: 40rem;
  }
</style>
